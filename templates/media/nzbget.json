{
	"$schema": "../schema.json",
	"name": "NZBGet",
	"description": "Usenet downloader, light enough for a Raspberry Pi, with Sonarr and Radarr support. Signs in as NZBGET_USER / NZBGET_PASS.",
	"image": "lscr.io/linuxserver/nzbget",
	"tag": "latest",
	"containerPort": 6789,
	"icon": "di:nzbget",
	"tags": ["usenet", "downloader", "nzb", "arr"],
	"websiteUrl": "https://nzbget.com",
	"sourceUrl": "https://github.com/nzbgetcom/nzbget",
	"envVars": {
		"NZBGET_PASS": "{{secret:hex16}}",
		"NZBGET_USER": "admin",
		"PGID": "1000",
		"PUID": "1000",
		"TZ": "UTC"
	},
	"volumes": ["/config", "/downloads"]
}
