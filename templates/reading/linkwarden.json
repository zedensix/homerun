{
	"$schema": "../schema.json",
	"name": "Linkwarden",
	"description": "Collaborative bookmark manager that keeps a screenshot, a PDF and a readable copy of every page you save, so links never rot. Comes with a linked Postgres.",
	"image": "ghcr.io/linkwarden/linkwarden",
	"tag": "latest",
	"containerPort": 3000,
	"icon": "di:linkwarden",
	"tags": ["bookmarks", "archive", "read-later", "collaboration"],
	"websiteUrl": "https://linkwarden.app",
	"sourceUrl": "https://github.com/linkwarden/linkwarden",
	"envVars": {
		"DATABASE_URL": "postgresql://{{db.POSTGRES_USER}}:{{db.POSTGRES_PASSWORD}}@{{db}}:5432/{{db.POSTGRES_DB}}",
		"NEXTAUTH_SECRET": "{{secret}}",
		"NEXTAUTH_URL": "{{url}}/api/v1/auth"
	},
	"volumes": ["/data/data"],
	"links": [
		{
			"alias": "db",
			"template": "postgres"
		}
	]
}
